{
  "name": "kele",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "preinstall": "node scripts/verify-runtime.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "corepack pnpm@11.18.0 -r --if-present typecheck",
    "test": "vitest run --config vitest.config.ts",
    "prisma:generate": "corepack pnpm@11.18.0 --filter @kele/api prisma:generate",
    "test:integration": "dotenv -e .env -- corepack pnpm@11.18.0 --filter @kele/api prisma:deploy && dotenv -e .env -- corepack pnpm@11.18.0 --filter @kele/api test:integration",
    "test:architecture": "node scripts/check-architecture.mjs",
    "openapi:validate": "redocly lint docs/openapi.yaml",
    "openapi:generate": "openapi-typescript docs/openapi.yaml -o packages/api-contract/src/generated.ts && prettier --write packages/api-contract/src/generated.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "build": "dotenv -e .env -v NODE_ENV=production -- corepack pnpm@11.18.0 -r --if-present build",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:m9:acceptance": "dotenv -e .env -v M9_RUN_LOAD=true -- node scripts/run-e2e.mjs e2e/milestone-9.spec.ts",
    "test:m9:full": "dotenv -e .env -v M9_RUN_LOAD=true -- node scripts/run-e2e.mjs",
    "test:m9:recovery": "dotenv -e .env -v NODE_ENV=test -v M9_RECOVERY_CONFIRM_SYNTHETIC=isolated-kele-e2e -- node scripts/rehearse-m9-recovery.mjs",
    "audit": "pnpm audit --prod --audit-level=high",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "services:up": "docker compose up -d postgres minio",
    "services:down": "docker compose down",
    "seed": "dotenv -e .env -- corepack pnpm@11.18.0 --filter @kele/api prisma:deploy && dotenv -e .env -- corepack pnpm@11.18.0 --filter @kele/api seed",
    "demo:quick-tunnel:start": "node scripts/quick-tunnel-demo.mjs start",
    "demo:quick-tunnel:verify": "node scripts/quick-tunnel-demo.mjs verify",
    "demo:quick-tunnel:urls": "node scripts/quick-tunnel-demo.mjs urls",
    "demo:quick-tunnel:reset": "node scripts/quick-tunnel-demo.mjs reset"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@redocly/cli": "2.43.0",
    "@types/node": "26.1.2",
    "@typescript-eslint/utils": "8.65.0",
    "dotenv": "16.6.1",
    "dotenv-cli": "11.0.0",
    "eslint": "10.8.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
