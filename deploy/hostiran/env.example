# Copy generated output to deploy/hostiran/.env on the VPS.
# Generate locally with:
#   pnpm deploy:hostiran:env -- shop.example.com +989121234567 > deploy/hostiran/.env
#
# This profile uses KELE_DEPLOYMENT_TIER=uat (initial launch without real
# payment or SMS). Object storage runs as private MinIO on the same VPS.

KELE_DOMAIN=shop.example.com
POSTGRES_PASSWORD=replace-me
STORAGE_BUCKET=kele-media
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me
