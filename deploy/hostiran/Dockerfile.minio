ARG MINIO_RELEASE=RELEASE.2025-04-22T22-12-26Z

FROM docker.arvancloud.ir/alpine:3.20

ARG MINIO_RELEASE

RUN sed -i 's|https://dl-cdn.alpinelinux.org/alpine|https://mirror.arvancloud.ir/alpine|g' /etc/apk/repositories \
    && apk add --no-cache ca-certificates curl \
    && curl -fsSL "https://github.com/minio/minio/releases/download/${MINIO_RELEASE}/minio.linux-amd64.${MINIO_RELEASE}" -o /usr/local/bin/minio \
    && chmod +x /usr/local/bin/minio \
    && adduser -D -u 1000 minio \
    && mkdir -p /data \
    && chown minio:minio /data

USER minio

VOLUME /data

EXPOSE 9000 9001

HEALTHCHECK --interval=5s --timeout=3s --retries=20 \
  CMD curl -fsS http://127.0.0.1:9000/minio/health/live

ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data", "--console-address", ":9001"]
