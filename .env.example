# Local development only. Copy this file to .env and do not commit it.
NODE_ENV=development
# Hosted deployments declare an explicit uat/staging/production tier. Local
# development intentionally leaves KELE_DEPLOYMENT_TIER unset.
PORT=3001
DATABASE_URL=postgresql://kele:kele@localhost:5432/kele?schema=public
E2E_DATABASE_URL=postgresql://kele:kele@localhost:5432/kele_e2e?schema=public
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=kele-development
STORAGE_ACCESS_KEY=kele-minio
STORAGE_SECRET_KEY=kele-minio-secret
# Local S3-compatible adapter. Production uses the ADR-0005 Arvan selection.
STORAGE_PROVIDER=minio
PAYMENT_PROVIDER=fake
REFUND_PROVIDER=fake
FAKE_PAYMENT_SIGNING_SECRET=development-fake-payment-signing-secret-0001
SMS_PROVIDER=fake
# Fixed sign-in code for the local Fake SMS provider only.
FAKE_SMS_OTP_CODE=111111
API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# Provisional display typography: elize (default) or markazi.
KELE_TYPOGRAPHY=elize
# Administration preview proxy for development media URI references.
STOREFRONT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002
# Provider-neutral local structured events; remote monitoring is blocked by OQ-017.
ERROR_MONITORING_PROVIDER=structured_log
# Approved production provider values are intentionally absent locally:
# VANDAR_IPG_API_KEY, VANDAR_REFUND_ACCESS_TOKEN,
# VANDAR_REFUND_REFRESH_TOKEN, VANDAR_BUSINESS_NAME,
# PAYMENT_CALLBACK_BASE_URL, KAVENEGAR_API_KEY, KAVENEGAR_OTP_TEMPLATE,
# STORAGE_PUBLIC_BASE_URL, ARVAN_CDN_API_TOKEN,
# LOKI_PUSH_URL, LOKI_TENANT_ID, LOKI_PUSH_TOKEN and
# GRAFANA_ADMIN_BOOTSTRAP_SECRET.
PROVIDER_CONNECT_TIMEOUT_MS=3000
PROVIDER_REQUEST_TIMEOUT_MS=10000
# Dedicated local metrics scraper credential. Never reuse an application session.
METRICS_BEARER_TOKEN=development-metrics-bearer-token-000001
# Explicit bounded HTTP and abuse controls.
API_JSON_BODY_LIMIT_BYTES=131072
READINESS_TIMEOUT_MS=1000
REQUEST_TIMEOUT_MS=15000
HEADERS_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000
TRUST_PROXY_HOPS=0
CALLBACK_RATE_LIMIT_PER_MINUTE=120
OTP_VERIFY_RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_MAX_KEYS=10000
# Development-only signing and OTP-verifier secrets. Replace both locally;
# development-prefixed values are rejected in production.
IDENTITY_SIGNING_SECRET=development-identity-signing-secret-00001
OTP_VERIFIER_PEPPER=development-otp-verifier-pepper-000001
# Development-only server-managed administrator session adapters.
# Replace them with high-entropy values locally. Development-prefixed values
# are rejected in production, where the identity milestone supplies sessions.
ADMIN_SUPER_SESSION_TOKEN=development-super-admin-session-token-00000001
ADMIN_INVENTORY_SESSION_TOKEN=development-inventory-admin-session-token-00001
ADMIN_INSTAGRAM_SESSION_TOKEN=development-instagram-admin-session-token-00001
# Static role sessions are a local/test harness and are rejected in production.
ADMIN_SESSION_PROVIDER=development_static
# PostgreSQL administrator sessions additionally require production-only
# ADMIN_SESSION_SIGNING_SECRET and ADMIN_OTP_VERIFIER_PEPPER. The one-time
# ADMIN_BOOTSTRAP_TOKEN_HASH belongs only to the approved offline bootstrap.
