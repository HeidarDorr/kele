generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SeedLedger {
  key       String   @id
  appliedAt DateTime @default(now()) @db.Timestamptz(6)
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("publication_status")
}

enum MediaFormat {
  JPG
  PNG
  WEBP

  @@map("media_format")
}

enum MediaGroup {
  PRODUCT_IMAGES
  OUTFIT_EDITORIAL
  HOMEPAGE
  JOURNAL
  SHARED_ASSETS

  @@map("media_group")
}

enum InventoryAction {
  PRODUCTION
  SALE
  RESERVATION
  RESERVATION_RELEASE
  CUSTOMER_RETURN
  MANUAL_CORRECTION
  DAMAGED_GOODS
  INSTAGRAM_SALE

  @@map("inventory_action")
}

enum CartStatus {
  ACTIVE
  MERGED

  @@map("cart_status")
}

enum CartLineKind {
  PRODUCT
  OUTFIT

  @@map("cart_line_kind")
}

enum CartLineStatus {
  AVAILABLE
  UNAVAILABLE
  REQUIRES_REVIEW

  @@map("cart_line_status")
}

enum CartNoticeCode {
  QUANTITY_REDUCED_TO_INVENTORY
  SKU_UNAVAILABLE
  OUTFIT_REVISION_REQUIRES_REVIEW

  @@map("cart_notice_code")
}

enum ShippingMethodCode {
  IRAN_POST
  TIPAX
  TEHRAN_LOCAL_COURIER

  @@map("shipping_method_code")
}

enum CheckoutStatus {
  ACTIVE
  PAYMENT_PENDING
  PAID
  EXPIRED
  CANCELLED
  RECONCILIATION

  @@map("checkout_status")
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED

  @@map("reservation_status")
}

enum PaymentAttemptStatus {
  CREATED
  REDIRECTED
  VERIFIED
  FAILED
  CANCELLED
  PENDING
  RECONCILIATION

  @@map("payment_attempt_status")
}

enum PaymentCallbackResult {
  PAID
  FAILED
  CANCELLED
  PENDING
  RECONCILIATION

  @@map("payment_callback_result")
}

enum OrderFulfillmentStatus {
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED

  @@map("order_fulfillment_status")
}

enum PaymentReconciliationStatus {
  OPEN
  RESOLVED
  FAILED

  @@map("payment_reconciliation_status")
}

enum DatabaseJobType {
  EXPIRE_CHECKOUT
  RECOVER_PAYMENT

  @@map("database_job_type")
}

enum DatabaseJobStatus {
  PENDING
  LEASED
  COMPLETED
  FAILED

  @@map("database_job_status")
}

model Customer {
  id        String            @id @default(uuid()) @db.Uuid
  mobile    String            @unique @db.VarChar(15)
  firstName String?           @map("first_name") @db.VarChar(80)
  lastName  String?           @map("last_name") @db.VarChar(80)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  addresses Address[]
  sessions  CustomerSession[]
  cart      Cart?
  checkouts CheckoutSession[]
  orders    Order[]

  @@map("customers")
}

model OtpChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  mobile         String    @db.VarChar(15)
  mobileHash     String    @map("mobile_hash") @db.Char(64)
  ipHash         String    @map("ip_hash") @db.Char(64)
  deviceHash     String    @map("device_hash") @db.Char(64)
  codeSalt       String    @map("code_salt") @db.Char(32)
  codeVerifier   String    @map("code_verifier") @db.Char(128)
  failedAttempts Int       @default(0) @map("failed_attempts")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([mobileHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([deviceHash, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model CustomerSession {
  id                String    @id @default(uuid()) @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  csrfHash          String    @map("csrf_hash") @db.Char(64)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("customer_sessions")
}

model Address {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  recipientName   String   @map("recipient_name") @db.VarChar(160)
  recipientMobile String   @map("recipient_mobile") @db.VarChar(15)
  province        String   @db.VarChar(100)
  city            String   @db.VarChar(100)
  addressLine     String   @map("address_line") @db.VarChar(500)
  postalCode      String   @map("postal_code") @db.Char(10)
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("addresses")
}

model Cart {
  id         String            @id @default(uuid()) @db.Uuid
  customerId String?           @unique @map("customer_id") @db.Uuid
  status     CartStatus        @default(ACTIVE)
  version    Int               @default(0)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  mergedAt   DateTime?         @map("merged_at") @db.Timestamptz(6)
  customer   Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines      CartLine[]
  notices    CartNotice[]
  checkouts  CheckoutSession[]
  guestMergeReceipt    CartMergeReceipt?  @relation("GuestCartMerge")
  customerMergeReceipts CartMergeReceipt[] @relation("CustomerCartMerge")

  @@index([status, updatedAt])
  @@map("carts")
}

model CartLine {
  id                String         @id @default(uuid()) @db.Uuid
  cartId            String         @map("cart_id") @db.Uuid
  kind              CartLineKind
  skuId             String?        @map("sku_id") @db.Uuid
  outfitRevisionId  String?        @map("outfit_revision_id") @db.Uuid
  outfitSize        String?        @map("outfit_size") @db.VarChar(40)
  titleSnapshot     String         @map("title_snapshot") @db.VarChar(180)
  selectionSnapshot String         @map("selection_snapshot") @db.VarChar(180)
  skuCodeSnapshot   String?        @map("sku_code_snapshot") @db.VarChar(64)
  imageSnapshot     Json?          @map("image_snapshot")
  quantity          Int
  status            CartLineStatus @default(AVAILABLE)
  unitPriceRial     BigInt         @map("unit_price_rial")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart              Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  notices           CartNotice[]

  @@index([cartId, createdAt])
  @@index([cartId, skuId])
  @@index([outfitRevisionId])
  @@map("cart_lines")
}

model CartNotice {
  id                String         @id @default(uuid()) @db.Uuid
  cartId            String         @map("cart_id") @db.Uuid
  lineId            String         @map("line_id") @db.Uuid
  code              CartNoticeCode
  requestedQuantity Int?           @map("requested_quantity")
  appliedQuantity   Int?           @map("applied_quantity")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  cart              Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  line              CartLine       @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([cartId, createdAt])
  @@map("cart_notices")
}

model CartMergeReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  guestCartId    String   @unique @map("guest_cart_id") @db.Uuid
  customerCartId String   @map("customer_cart_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  guestCart      Cart     @relation("GuestCartMerge", fields: [guestCartId], references: [id], onDelete: Restrict)
  customerCart   Cart     @relation("CustomerCartMerge", fields: [customerCartId], references: [id], onDelete: Restrict)

  @@index([customerCartId, createdAt])
  @@map("cart_merge_receipts")
}

model Category {
  id           String            @id @default(uuid()) @db.Uuid
  name         String            @db.VarChar(120)
  slug         String            @unique @db.VarChar(160)
  description  String?           @db.Text
  status       PublicationStatus @default(DRAFT)
  displayOrder Int               @default(0) @map("display_order")
  version      Int               @default(1)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt   DateTime?         @map("archived_at") @db.Timestamptz(6)
  products     ProductCategory[]

  @@index([status, displayOrder])
  @@map("categories")
}

model Product {
  id             String            @id @default(uuid()) @db.Uuid
  name           String            @db.VarChar(180)
  slug           String            @unique @db.VarChar(160)
  description    String            @db.Text
  details        String[]          @default([])
  status         PublicationStatus @default(DRAFT)
  seoTitle       String?           @map("seo_title") @db.VarChar(180)
  seoDescription String?           @map("seo_description") @db.VarChar(320)
  searchText     String            @default("") @map("search_text") @db.Text
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt    DateTime?         @map("published_at") @db.Timestamptz(6)
  archivedAt     DateTime?         @map("archived_at") @db.Timestamptz(6)
  categories     ProductCategory[]
  variants       ColorVariant[]

  @@index([status, createdAt])
  @@index([status, slug])
  @@map("products")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
  @@map("product_categories")
}

model ColorVariant {
  id                  String            @id @default(uuid()) @db.Uuid
  productId           String            @map("product_id") @db.Uuid
  name                String            @db.VarChar(100)
  normalizedColorCode String            @map("normalized_color_code") @db.VarChar(40)
  displayHex          String?           @map("display_hex") @db.VarChar(7)
  status              PublicationStatus @default(DRAFT)
  displayOrder        Int               @default(0) @map("display_order")
  version             Int               @default(1)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt          DateTime?         @map("archived_at") @db.Timestamptz(6)
  product             Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  mediaAssignments    MediaAssignment[]
  skus                Sku[]

  @@unique([productId, normalizedColorCode])
  @@index([productId, status, displayOrder])
  @@map("color_variants")
}

model MediaAsset {
  id          String            @id @default(uuid()) @db.Uuid
  url         String            @db.VarChar(500)
  width       Int
  height      Int
  altText     String            @map("alt_text") @db.VarChar(500)
  focalPointX Float             @default(0.5) @map("focal_point_x")
  focalPointY Float             @default(0.5) @map("focal_point_y")
  format      MediaFormat
  group       MediaGroup
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt  DateTime?         @map("archived_at") @db.Timestamptz(6)
  assignments MediaAssignment[]

  @@index([group, createdAt])
  @@map("media_assets")
}

model MediaAssignment {
  colorVariantId String       @map("color_variant_id") @db.Uuid
  mediaAssetId   String       @map("media_asset_id") @db.Uuid
  displayOrder   Int          @default(0) @map("display_order")
  featured       Boolean      @default(false)
  colorVariant   ColorVariant @relation(fields: [colorVariantId], references: [id], onDelete: Cascade)
  mediaAsset     MediaAsset   @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([colorVariantId, mediaAssetId])
  @@index([colorVariantId, displayOrder])
  @@map("media_assignments")
}

model Sku {
  id             String                 @id @default(uuid()) @db.Uuid
  colorVariantId String                 @map("color_variant_id") @db.Uuid
  code           String                 @unique @db.VarChar(64)
  normalizedSize String                 @map("normalized_size") @db.VarChar(40)
  displaySize    String                 @map("display_size") @db.VarChar(40)
  status         PublicationStatus      @default(DRAFT)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt     DateTime?              @map("archived_at") @db.Timestamptz(6)
  colorVariant   ColorVariant           @relation(fields: [colorVariantId], references: [id], onDelete: Restrict)
  priceRecords   PriceRecord[]
  currentPrice   CurrentSkuPrice?
  inventory      Inventory?
  movements      InventoryMovement[]
  reservations   InventoryReservation[]
  orderItems     OrderItem[]

  @@unique([colorVariantId, normalizedSize])
  @@index([colorVariantId, status])
  @@map("skus")
}

model PriceRecord {
  id         String           @id @default(uuid()) @db.Uuid
  skuId      String           @map("sku_id") @db.Uuid
  amountRial BigInt           @map("amount_rial")
  validFrom  DateTime         @default(now()) @map("valid_from") @db.Timestamptz(6)
  /// Immutable once appended. CurrentSkuPrice, not mutation of this field, selects the live price.
  validTo    DateTime?        @map("valid_to") @db.Timestamptz(6)
  actorId    String           @map("actor_id") @db.VarChar(120)
  reason     String           @db.VarChar(500)
  sku        Sku              @relation(fields: [skuId], references: [id], onDelete: Restrict)
  projection CurrentSkuPrice?

  @@index([skuId, validFrom])
  @@map("price_records")
}

model CurrentSkuPrice {
  skuId         String      @id @map("sku_id") @db.Uuid
  priceRecordId String      @unique @map("price_record_id") @db.Uuid
  amountRial    BigInt      @map("amount_rial")
  version       Int         @default(1)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  sku           Sku         @relation(fields: [skuId], references: [id], onDelete: Restrict)
  priceRecord   PriceRecord @relation(fields: [priceRecordId], references: [id], onDelete: Restrict)

  @@map("current_sku_prices")
}

model Inventory {
  skuId            String   @id @map("sku_id") @db.Uuid
  physicalQuantity Int      @default(0) @map("physical_quantity")
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  version          Int      @default(1)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  sku              Sku      @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@index([physicalQuantity, reservedQuantity])
  @@map("inventory")
}

model InventoryMovement {
  id                     String                @id @default(uuid()) @db.Uuid
  skuId                  String                @map("sku_id") @db.Uuid
  action                 InventoryAction
  quantityDelta          Int                   @map("quantity_delta")
  beforePhysicalQuantity Int                   @map("before_physical_quantity")
  afterPhysicalQuantity  Int                   @map("after_physical_quantity")
  beforeReservedQuantity Int                   @map("before_reserved_quantity")
  afterReservedQuantity  Int                   @map("after_reserved_quantity")
  actorId                String                @map("actor_id") @db.VarChar(120)
  reason                 String                @db.VarChar(500)
  correlationId          String                @map("correlation_id") @db.Uuid
  idempotencyKey         String                @unique @map("idempotency_key") @db.VarChar(120)
  reservationId          String?               @map("reservation_id") @db.Uuid
  orderId                String?               @map("order_id") @db.Uuid
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  sku                    Sku                   @relation(fields: [skuId], references: [id], onDelete: Restrict)
  reservation            InventoryReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  order                  Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([skuId, createdAt])
  @@index([reservationId])
  @@index([orderId])
  @@map("inventory_movements")
}

model BusinessEvent {
  id            String   @id @default(uuid()) @db.Uuid
  type          String   @db.VarChar(120)
  actorId       String   @map("actor_id") @db.VarChar(120)
  entityType    String   @map("entity_type") @db.VarChar(80)
  entityId      String   @map("entity_id") @db.VarChar(120)
  correlationId String   @map("correlation_id") @db.Uuid
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("business_events")
}

model CommandReceipt {
  idempotencyKey String   @id @map("idempotency_key") @db.VarChar(120)
  commandType    String   @map("command_type") @db.VarChar(120)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  entityId       String   @map("entity_id") @db.VarChar(120)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([commandType, entityId])
  @@map("command_receipts")
}

model ShippingPolicyVersion {
  id                        String                  @id @default(uuid()) @db.Uuid
  version                   Int                     @unique
  freeShippingThresholdRial BigInt?                 @map("free_shipping_threshold_rial")
  eligibilityBasis          String                  @default("order_subtotal") @map("eligibility_basis") @db.VarChar(40)
  effectiveAt               DateTime                @map("effective_at") @db.Timestamptz(6)
  actorId                   String                  @map("actor_id") @db.VarChar(120)
  reason                    String                  @db.VarChar(500)
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  methods                   ShippingMethodVersion[]
  checkouts                 CheckoutSession[]

  @@index([effectiveAt])
  @@map("shipping_policy_versions")
}

model ShippingMethodVersion {
  id             String                @id @default(uuid()) @db.Uuid
  policyId       String                @map("policy_id") @db.Uuid
  code           ShippingMethodCode
  localizedName  String                @map("localized_name") @db.VarChar(120)
  fixedPriceRial BigInt                @map("fixed_price_rial")
  enabled        Boolean               @default(true)
  displayOrder   Int                   @map("display_order")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  policy         ShippingPolicyVersion @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@unique([policyId, code])
  @@index([policyId, displayOrder])
  @@map("shipping_method_versions")
}

model CheckoutSession {
  id                        String                  @id @default(uuid()) @db.Uuid
  customerId                String                  @map("customer_id") @db.Uuid
  cartId                    String                  @map("cart_id") @db.Uuid
  cartVersion               Int                     @map("cart_version")
  status                    CheckoutStatus          @default(ACTIVE)
  idempotencyKey            String                  @map("idempotency_key") @db.VarChar(120)
  requestHash               String                  @map("request_hash") @db.Char(64)
  currency                  String                  @default("IRR") @db.Char(3)
  itemsSubtotalRial         BigInt                  @map("items_subtotal_rial")
  shippingTotalRial         BigInt                  @map("shipping_total_rial")
  payableTotalRial          BigInt                  @map("payable_total_rial")
  addressSnapshot           Json                    @map("address_snapshot")
  shippingMethodCode        ShippingMethodCode      @map("shipping_method_code")
  shippingMethodName        String                  @map("shipping_method_name") @db.VarChar(120)
  shippingFixedPriceRial    BigInt                  @map("shipping_fixed_price_rial")
  freeShippingThresholdRial BigInt?                 @map("free_shipping_threshold_rial")
  freeShippingApplied       Boolean                 @map("free_shipping_applied")
  shippingSettingsVersion   Int                     @map("shipping_settings_version")
  expiresAt                 DateTime                @map("expires_at") @db.Timestamptz(6)
  paidAt                    DateTime?               @map("paid_at") @db.Timestamptz(6)
  expiredAt                 DateTime?               @map("expired_at") @db.Timestamptz(6)
  cancelledAt               DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer                  Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cart                      Cart                    @relation(fields: [cartId], references: [id], onDelete: Restrict)
  shippingPolicy            ShippingPolicyVersion   @relation(fields: [shippingSettingsVersion], references: [version], onDelete: Restrict)
  lines                     CheckoutLine[]
  reservations              InventoryReservation[]
  paymentAttempts           PaymentAttempt[]
  order                     Order?
  reconciliationCases       PaymentReconciliation[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt])
  @@index([cartId, status])
  @@index([status, expiresAt])
  @@map("checkout_sessions")
}

model CheckoutLine {
  id                String                 @id @default(uuid()) @db.Uuid
  checkoutSessionId String                 @map("checkout_session_id") @db.Uuid
  cartLineId        String                 @map("cart_line_id") @db.Uuid
  kind              CartLineKind
  skuId             String?                @map("sku_id") @db.Uuid
  outfitRevisionId  String?                @map("outfit_revision_id") @db.Uuid
  outfitSize        String?                @map("outfit_size") @db.VarChar(40)
  titleSnapshot     String                 @map("title_snapshot") @db.VarChar(180)
  selectionSnapshot String                 @map("selection_snapshot") @db.VarChar(180)
  skuCodeSnapshot   String?                @map("sku_code_snapshot") @db.VarChar(64)
  imageSnapshot     Json?                  @map("image_snapshot")
  quantity          Int
  unitPriceRial     BigInt                 @map("unit_price_rial")
  lineTotalRial     BigInt                 @map("line_total_rial")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  checkoutSession   CheckoutSession        @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  reservations      InventoryReservation[]

  @@unique([checkoutSessionId, cartLineId])
  @@index([skuId])
  @@map("checkout_lines")
}

model InventoryReservation {
  id                String              @id @default(uuid()) @db.Uuid
  checkoutSessionId String              @map("checkout_session_id") @db.Uuid
  checkoutLineId    String              @map("checkout_line_id") @db.Uuid
  skuId             String              @map("sku_id") @db.Uuid
  quantity          Int
  status            ReservationStatus   @default(ACTIVE)
  expiresAt         DateTime            @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime?           @map("consumed_at") @db.Timestamptz(6)
  releasedAt        DateTime?           @map("released_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  checkoutSession   CheckoutSession     @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  checkoutLine      CheckoutLine        @relation(fields: [checkoutLineId], references: [id], onDelete: Restrict)
  sku               Sku                 @relation(fields: [skuId], references: [id], onDelete: Restrict)
  movements         InventoryMovement[]

  @@unique([checkoutLineId, skuId])
  @@index([checkoutSessionId, status])
  @@index([status, expiresAt])
  @@index([skuId, status])
  @@map("inventory_reservations")
}

model PaymentAttempt {
  id                    String                   @id @default(uuid()) @db.Uuid
  checkoutSessionId     String                   @map("checkout_session_id") @db.Uuid
  provider              String                   @db.VarChar(40)
  providerReference     String                   @map("provider_reference") @db.VarChar(120)
  providerTransactionId String?                  @map("provider_transaction_id") @db.VarChar(120)
  status                PaymentAttemptStatus     @default(CREATED)
  amountRial            BigInt                   @map("amount_rial")
  currency              String                   @default("IRR") @db.Char(3)
  redirectUrl           String?                  @map("redirect_url") @db.VarChar(1000)
  idempotencyKey        String                   @map("idempotency_key") @db.VarChar(120)
  requestHash           String                   @map("request_hash") @db.Char(64)
  failureCode           String?                  @map("failure_code") @db.VarChar(120)
  verifiedAt            DateTime?                @map("verified_at") @db.Timestamptz(6)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  checkoutSession       CheckoutSession          @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  callbacks             PaymentCallbackReceipt[]
  order                 Order?
  reconciliationCases   PaymentReconciliation[]

  @@unique([checkoutSessionId, idempotencyKey])
  @@unique([provider, providerReference])
  @@unique([provider, providerTransactionId])
  @@index([checkoutSessionId, createdAt])
  @@index([status, updatedAt])
  @@map("payment_attempts")
}

model PaymentCallbackReceipt {
  id                    String                @id @default(uuid()) @db.Uuid
  paymentAttemptId      String                @map("payment_attempt_id") @db.Uuid
  provider              String                @db.VarChar(40)
  providerTransactionId String                @map("provider_transaction_id") @db.VarChar(120)
  payloadHash           String                @map("payload_hash") @db.Char(64)
  result                PaymentCallbackResult
  orderId               String?               @map("order_id") @db.Uuid
  receivedAt            DateTime              @default(now()) @map("received_at") @db.Timestamptz(6)
  paymentAttempt        PaymentAttempt        @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  order                 Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, providerTransactionId])
  @@index([paymentAttemptId, receivedAt])
  @@map("payment_callback_receipts")
}

model Order {
  id                        String                   @id @default(uuid()) @db.Uuid
  orderNumber               String                   @unique @map("order_number") @db.VarChar(40)
  customerId                String                   @map("customer_id") @db.Uuid
  checkoutSessionId         String                   @unique @map("checkout_session_id") @db.Uuid
  paymentAttemptId          String                   @unique @map("payment_attempt_id") @db.Uuid
  fulfillmentStatus         OrderFulfillmentStatus   @default(PAID) @map("fulfillment_status")
  currency                  String                   @default("IRR") @db.Char(3)
  itemsSubtotalRial         BigInt                   @map("items_subtotal_rial")
  shippingTotalRial         BigInt                   @map("shipping_total_rial")
  paidTotalRial             BigInt                   @map("paid_total_rial")
  addressSnapshot           Json                     @map("address_snapshot")
  shippingMethodCode        ShippingMethodCode       @map("shipping_method_code")
  shippingMethodName        String                   @map("shipping_method_name") @db.VarChar(120)
  shippingFixedPriceRial    BigInt                   @map("shipping_fixed_price_rial")
  freeShippingThresholdRial BigInt?                  @map("free_shipping_threshold_rial")
  freeShippingApplied       Boolean                  @map("free_shipping_applied")
  shippingSettingsVersion   Int                      @map("shipping_settings_version")
  paymentProvider           String                   @map("payment_provider") @db.VarChar(40)
  providerTransactionId     String                   @map("provider_transaction_id") @db.VarChar(120)
  paidAt                    DateTime                 @map("paid_at") @db.Timestamptz(6)
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  customer                  Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  checkoutSession           CheckoutSession          @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  paymentAttempt            PaymentAttempt           @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  items                     OrderItem[]
  callbacks                 PaymentCallbackReceipt[]
  movements                 InventoryMovement[]

  @@unique([paymentProvider, providerTransactionId])
  @@index([customerId, createdAt])
  @@index([fulfillmentStatus, createdAt])
  @@map("orders")
}

model OrderItem {
  id                String       @id @default(uuid()) @db.Uuid
  orderId           String       @map("order_id") @db.Uuid
  kind              CartLineKind
  skuId             String?      @map("sku_id") @db.Uuid
  outfitRevisionId  String?      @map("outfit_revision_id") @db.Uuid
  outfitSize        String?      @map("outfit_size") @db.VarChar(40)
  titleSnapshot     String       @map("title_snapshot") @db.VarChar(180)
  selectionSnapshot String       @map("selection_snapshot") @db.VarChar(180)
  skuCodeSnapshot   String?      @map("sku_code_snapshot") @db.VarChar(64)
  imageSnapshot     Json?        @map("image_snapshot")
  quantity          Int
  unitPriceRial     BigInt       @map("unit_price_rial")
  lineTotalRial     BigInt       @map("line_total_rial")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sku               Sku?         @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([skuId])
  @@map("order_items")
}

model PaymentReconciliation {
  id                    String                      @id @default(uuid()) @db.Uuid
  checkoutSessionId     String                      @map("checkout_session_id") @db.Uuid
  paymentAttemptId      String                      @map("payment_attempt_id") @db.Uuid
  provider              String                      @db.VarChar(40)
  providerTransactionId String                      @map("provider_transaction_id") @db.VarChar(120)
  verifiedAmountRial    BigInt                      @map("verified_amount_rial")
  currency              String                      @db.Char(3)
  reason                String                      @db.VarChar(120)
  status                PaymentReconciliationStatus @default(OPEN)
  resolutionNote        String?                     @map("resolution_note") @db.VarChar(1000)
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  checkoutSession       CheckoutSession             @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  paymentAttempt        PaymentAttempt              @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@unique([provider, providerTransactionId])
  @@index([status, createdAt])
  @@map("payment_reconciliations")
}

model DatabaseJob {
  id             String            @id @default(uuid()) @db.Uuid
  type           DatabaseJobType
  idempotencyKey String            @unique @map("idempotency_key") @db.VarChar(160)
  payload        Json
  status         DatabaseJobStatus @default(PENDING)
  runAt          DateTime          @map("run_at") @db.Timestamptz(6)
  attemptCount   Int               @default(0) @map("attempt_count")
  maxAttempts    Int               @default(8) @map("max_attempts")
  leaseOwner     String?           @map("lease_owner") @db.VarChar(120)
  leaseExpiresAt DateTime?         @map("lease_expires_at") @db.Timestamptz(6)
  lastErrorCode  String?           @map("last_error_code") @db.VarChar(120)
  lastError      String?           @map("last_error") @db.VarChar(1000)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, runAt])
  @@index([leaseExpiresAt])
  @@map("database_jobs")
}
