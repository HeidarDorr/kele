generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SeedLedger {
  key       String   @id
  appliedAt DateTime @default(now()) @db.Timestamptz(6)
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("publication_status")
}

enum OutfitRevisionState {
  DRAFT
  PUBLISHED
  HISTORICAL

  @@map("outfit_revision_state")
}

enum EditorialRevisionState {
  DRAFT
  PUBLISHED
  HISTORICAL

  @@map("editorial_revision_state")
}

enum DiscoveryKind {
  CATALOG
  OCCASION

  @@map("discovery_kind")
}

enum MediaFormat {
  JPG
  PNG
  WEBP

  @@map("media_format")
}

enum MediaGroup {
  PRODUCT_IMAGES
  OUTFIT_EDITORIAL
  HOMEPAGE
  JOURNAL
  SHARED_ASSETS

  @@map("media_group")
}

enum InventoryAction {
  PRODUCTION
  SALE
  RESERVATION
  RESERVATION_RELEASE
  CUSTOMER_RETURN
  MANUAL_CORRECTION
  DAMAGED_GOODS
  INSTAGRAM_SALE
  INSTAGRAM_RETURN
  ORDER_CANCELLATION

  @@map("inventory_action")
}

enum CartStatus {
  ACTIVE
  MERGED

  @@map("cart_status")
}

enum CartLineKind {
  PRODUCT
  OUTFIT

  @@map("cart_line_kind")
}

enum CartLineStatus {
  AVAILABLE
  UNAVAILABLE
  REQUIRES_REVIEW

  @@map("cart_line_status")
}

enum CartNoticeCode {
  QUANTITY_REDUCED_TO_INVENTORY
  SKU_UNAVAILABLE
  OUTFIT_REVISION_REQUIRES_REVIEW

  @@map("cart_notice_code")
}

enum ShippingMethodCode {
  IRAN_POST
  TIPAX
  TEHRAN_LOCAL_COURIER

  @@map("shipping_method_code")
}

enum CheckoutStatus {
  ACTIVE
  PAYMENT_PENDING
  PAID
  EXPIRED
  CANCELLED
  RECONCILIATION

  @@map("checkout_status")
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED

  @@map("reservation_status")
}

enum PaymentAttemptStatus {
  CREATED
  REDIRECTED
  VERIFIED
  FAILED
  CANCELLED
  PENDING
  RECONCILIATION

  @@map("payment_attempt_status")
}

enum PaymentCallbackResult {
  PAID
  FAILED
  CANCELLED
  PENDING
  RECONCILIATION

  @@map("payment_callback_result")
}

enum OrderFulfillmentStatus {
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED

  @@map("order_fulfillment_status")
}

enum ReturnRequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
  REFUND_PENDING
  COMPLETED

  @@map("return_request_status")
}

enum RefundStatus {
  PENDING_PROVIDER
  CONFIRMED
  FAILED

  @@map("refund_status")
}

enum RefundSource {
  CANCELLATION
  RETURN

  @@map("refund_source")
}

enum AdministratorRole {
  SUPER_ADMIN
  INVENTORY_ADMIN
  INSTAGRAM_ADMIN

  @@map("administrator_role")
}

enum BulkOperationKind {
  PRICE
  INVENTORY

  @@map("bulk_operation_kind")
}

enum BulkOperationStatus {
  PREVIEWED
  APPLIED
  PARTIAL_FAILED
  FAILED

  @@map("bulk_operation_status")
}

enum BulkOperationItemStatus {
  VALID
  APPLIED
  FAILED

  @@map("bulk_operation_item_status")
}

enum PaymentReconciliationStatus {
  OPEN
  RESOLVED
  FAILED

  @@map("payment_reconciliation_status")
}

enum DatabaseJobType {
  EXPIRE_CHECKOUT
  RECOVER_PAYMENT

  @@map("database_job_type")
}

enum DatabaseJobStatus {
  PENDING
  LEASED
  COMPLETED
  FAILED

  @@map("database_job_status")
}

model Customer {
  id             String            @id @default(uuid()) @db.Uuid
  mobile         String            @unique @db.VarChar(15)
  firstName      String?           @map("first_name") @db.VarChar(80)
  lastName       String?           @map("last_name") @db.VarChar(80)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  addresses      Address[]
  sessions       CustomerSession[]
  cart           Cart?
  checkouts      CheckoutSession[]
  orders         Order[]
  returnRequests ReturnRequest[]

  @@map("customers")
}

model OtpChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  mobile         String    @db.VarChar(15)
  mobileHash     String    @map("mobile_hash") @db.Char(64)
  ipHash         String    @map("ip_hash") @db.Char(64)
  deviceHash     String    @map("device_hash") @db.Char(64)
  codeSalt       String    @map("code_salt") @db.Char(32)
  codeVerifier   String    @map("code_verifier") @db.Char(128)
  failedAttempts Int       @default(0) @map("failed_attempts")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([mobileHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([deviceHash, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model CustomerSession {
  id                String    @id @default(uuid()) @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  csrfHash          String    @map("csrf_hash") @db.Char(64)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("customer_sessions")
}

model Administrator {
  id           String                   @id @default(uuid()) @db.Uuid
  mobile       String                   @unique @db.VarChar(15)
  displayName  String                   @map("display_name") @db.VarChar(160)
  role         AdministratorRole
  enabled      Boolean                  @default(true)
  version      Int                      @default(1)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  challenges   AdministratorOtpChallenge[]
  sessions     AdministratorSession[]
  identityAudit AdministratorIdentityAudit[]

  @@index([enabled, role])
  @@map("administrators")
}

model AdministratorOtpChallenge {
  id              String         @id @default(uuid()) @db.Uuid
  administratorId String?        @map("administrator_id") @db.Uuid
  mobileHash      String         @map("mobile_hash") @db.Char(64)
  ipHash          String         @map("ip_hash") @db.Char(64)
  codeSalt        String         @map("code_salt") @db.Char(32)
  codeVerifier    String         @map("code_verifier") @db.Char(128)
  failedAttempts  Int            @default(0) @map("failed_attempts")
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(6)
  consumedAt      DateTime?      @map("consumed_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  administrator   Administrator? @relation(fields: [administratorId], references: [id], onDelete: Restrict)

  @@index([mobileHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([expiresAt])
  @@map("administrator_otp_challenges")
}

model AdministratorSession {
  id                String        @id @default(uuid()) @db.Uuid
  administratorId   String        @map("administrator_id") @db.Uuid
  tokenHash         String        @unique @map("token_hash") @db.Char(64)
  csrfHash          String        @map("csrf_hash") @db.Char(64)
  idleExpiresAt     DateTime      @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime      @map("absolute_expires_at") @db.Timestamptz(6)
  lastSeenAt        DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt         DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  administrator     Administrator @relation(fields: [administratorId], references: [id], onDelete: Restrict)

  @@index([administratorId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("administrator_sessions")
}

model AdministratorIdentityAudit {
  id                String         @id @default(uuid()) @db.Uuid
  administratorId   String?        @map("administrator_id") @db.Uuid
  action            String         @db.VarChar(64)
  outcome           String         @db.VarChar(64)
  correlationId     String         @map("correlation_id") @db.VarChar(128)
  occurredAt        DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  administrator     Administrator? @relation(fields: [administratorId], references: [id], onDelete: Restrict)

  @@index([administratorId, occurredAt])
  @@index([action, occurredAt])
  @@map("administrator_identity_audit")
}

model Address {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  recipientName   String   @map("recipient_name") @db.VarChar(160)
  recipientMobile String   @map("recipient_mobile") @db.VarChar(15)
  province        String   @db.VarChar(100)
  city            String   @db.VarChar(100)
  addressLine     String   @map("address_line") @db.VarChar(500)
  postalCode      String   @map("postal_code") @db.Char(10)
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("addresses")
}

model Cart {
  id                    String             @id @default(uuid()) @db.Uuid
  customerId            String?            @unique @map("customer_id") @db.Uuid
  status                CartStatus         @default(ACTIVE)
  version               Int                @default(0)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  mergedAt              DateTime?          @map("merged_at") @db.Timestamptz(6)
  customer              Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines                 CartLine[]
  notices               CartNotice[]
  checkouts             CheckoutSession[]
  guestMergeReceipt     CartMergeReceipt?  @relation("GuestCartMerge")
  customerMergeReceipts CartMergeReceipt[] @relation("CustomerCartMerge")

  @@index([status, updatedAt])
  @@map("carts")
}

model CartLine {
  id                   String          @id @default(uuid()) @db.Uuid
  cartId               String          @map("cart_id") @db.Uuid
  kind                 CartLineKind
  skuId                String?         @map("sku_id") @db.Uuid
  outfitRevisionId     String?         @map("outfit_revision_id") @db.Uuid
  outfitRevisionNumber Int?            @map("outfit_revision_number")
  outfitSize           String?         @map("outfit_size") @db.VarChar(40)
  titleSnapshot        String          @map("title_snapshot") @db.VarChar(180)
  selectionSnapshot    String          @map("selection_snapshot") @db.VarChar(180)
  skuCodeSnapshot      String?         @map("sku_code_snapshot") @db.VarChar(64)
  imageSnapshot        Json?           @map("image_snapshot")
  quantity             Int
  status               CartLineStatus  @default(AVAILABLE)
  unitPriceRial        BigInt          @map("unit_price_rial")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart                 Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  outfitRevision       OutfitRevision? @relation(fields: [outfitRevisionId], references: [id], onDelete: Restrict)
  notices              CartNotice[]

  @@index([cartId, createdAt])
  @@index([cartId, skuId])
  @@index([outfitRevisionId])
  @@map("cart_lines")
}

model CartNotice {
  id                String         @id @default(uuid()) @db.Uuid
  cartId            String         @map("cart_id") @db.Uuid
  lineId            String         @map("line_id") @db.Uuid
  code              CartNoticeCode
  requestedQuantity Int?           @map("requested_quantity")
  appliedQuantity   Int?           @map("applied_quantity")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  cart              Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  line              CartLine       @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([cartId, createdAt])
  @@map("cart_notices")
}

model CartMergeReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  guestCartId    String   @unique @map("guest_cart_id") @db.Uuid
  customerCartId String   @map("customer_cart_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  guestCart      Cart     @relation("GuestCartMerge", fields: [guestCartId], references: [id], onDelete: Restrict)
  customerCart   Cart     @relation("CustomerCartMerge", fields: [customerCartId], references: [id], onDelete: Restrict)

  @@index([customerCartId, createdAt])
  @@map("cart_merge_receipts")
}

model Category {
  id                   String            @id @default(uuid()) @db.Uuid
  name                 String            @db.VarChar(120)
  slug                 String            @unique @db.VarChar(160)
  description          String?           @db.Text
  status               PublicationStatus @default(DRAFT)
  displayOrder         Int               @default(0) @map("display_order")
  version              Int               @default(1)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt           DateTime?         @map("archived_at") @db.Timestamptz(6)
  discoveryKind        DiscoveryKind     @default(CATALOG) @map("discovery_kind")
  editorialTitle       String?           @map("editorial_title") @db.VarChar(180)
  editorialDescription String?           @map("editorial_description") @db.Text
  heroMediaId          String?           @map("hero_media_id") @db.Uuid
  seoTitle             String?           @map("seo_title") @db.VarChar(180)
  seoDescription       String?           @map("seo_description") @db.VarChar(320)
  products             ProductCategory[]
  outfits              OutfitCategory[]
  heroMedia            MediaAsset?       @relation("CategoryHero", fields: [heroMediaId], references: [id], onDelete: Restrict)

  @@index([status, displayOrder])
  @@map("categories")
}

model Product {
  id             String            @id @default(uuid()) @db.Uuid
  name           String            @db.VarChar(180)
  slug           String            @unique @db.VarChar(160)
  description    String            @db.Text
  details        String[]          @default([])
  status         PublicationStatus @default(DRAFT)
  seoTitle       String?           @map("seo_title") @db.VarChar(180)
  seoDescription String?           @map("seo_description") @db.VarChar(320)
  searchText     String            @default("") @map("search_text") @db.Text
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt    DateTime?         @map("published_at") @db.Timestamptz(6)
  archivedAt     DateTime?         @map("archived_at") @db.Timestamptz(6)
  categories     ProductCategory[]
  variants       ColorVariant[]
  outfitItems    OutfitItem[]

  @@index([status, createdAt])
  @@index([status, slug])
  @@map("products")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
  @@map("product_categories")
}

model Outfit {
  id          String            @id @default(uuid()) @db.Uuid
  slug        String            @unique @db.VarChar(160)
  status      PublicationStatus @default(DRAFT)
  version     Int               @default(1)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime?         @map("published_at") @db.Timestamptz(6)
  archivedAt  DateTime?         @map("archived_at") @db.Timestamptz(6)
  revisions   OutfitRevision[]
  categories  OutfitCategory[]

  @@index([status, createdAt])
  @@index([status, slug])
  @@map("outfits")
}

model OutfitCategory {
  outfitId   String   @map("outfit_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  outfit     Outfit   @relation(fields: [outfitId], references: [id], onDelete: Restrict)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([outfitId, categoryId])
  @@index([categoryId, outfitId])
  @@map("outfit_categories")
}

model OutfitRevision {
  id               String                @id @default(uuid()) @db.Uuid
  outfitId         String                @map("outfit_id") @db.Uuid
  revisionNumber   Int                   @map("revision_number")
  state            OutfitRevisionState   @default(DRAFT)
  name             String                @db.VarChar(180)
  description      String                @db.Text
  seoTitle         String?               @map("seo_title") @db.VarChar(180)
  seoDescription   String?               @map("seo_description") @db.VarChar(320)
  version          Int                   @default(1)
  sourceRevisionId String?               @map("source_revision_id") @db.Uuid
  publishedAt      DateTime?             @map("published_at") @db.Timestamptz(6)
  supersededAt     DateTime?             @map("superseded_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  outfit           Outfit                @relation(fields: [outfitId], references: [id], onDelete: Restrict)
  sourceRevision   OutfitRevision?       @relation("OutfitRevisionFork", fields: [sourceRevisionId], references: [id], onDelete: Restrict)
  forks            OutfitRevision[]      @relation("OutfitRevisionFork")
  items            OutfitItem[]
  sizes            OutfitSize[]
  media            OutfitRevisionMedia[]
  cartLines        CartLine[]
  checkoutLines    CheckoutLine[]
  orderItems       OrderItem[]

  @@unique([outfitId, revisionNumber])
  @@index([outfitId, state, revisionNumber])
  @@map("outfit_revisions")
}

model OutfitItem {
  id                    String                @id @db.Uuid
  outfitRevisionId      String                @map("outfit_revision_id") @db.Uuid
  productId             String                @map("product_id") @db.Uuid
  defaultColorVariantId String                @map("default_color_variant_id") @db.Uuid
  quantity              Int
  displayOrder          Int                   @map("display_order")
  outfitRevision        OutfitRevision        @relation(fields: [outfitRevisionId], references: [id], onDelete: Restrict)
  product               Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  defaultColorVariant   ColorVariant          @relation(fields: [defaultColorVariantId], references: [id], onDelete: Restrict)
  sizeComponents        OutfitSizeComponent[]

  @@unique([outfitRevisionId, displayOrder])
  @@index([productId])
  @@index([defaultColorVariantId])
  @@map("outfit_items")
}

model OutfitSize {
  id               String                @id @default(uuid()) @db.Uuid
  outfitRevisionId String                @map("outfit_revision_id") @db.Uuid
  code             String                @db.VarChar(40)
  label            String                @db.VarChar(80)
  amountRial       BigInt                @map("amount_rial")
  displayOrder     Int                   @map("display_order")
  outfitRevision   OutfitRevision        @relation(fields: [outfitRevisionId], references: [id], onDelete: Restrict)
  components       OutfitSizeComponent[]

  @@unique([outfitRevisionId, code])
  @@unique([outfitRevisionId, displayOrder])
  @@map("outfit_sizes")
}

model OutfitSizeComponent {
  id           String     @id @default(uuid()) @db.Uuid
  outfitSizeId String     @map("outfit_size_id") @db.Uuid
  outfitItemId String     @map("outfit_item_id") @db.Uuid
  skuId        String     @map("sku_id") @db.Uuid
  quantity     Int
  displayOrder Int        @map("display_order")
  outfitSize   OutfitSize @relation(fields: [outfitSizeId], references: [id], onDelete: Restrict)
  outfitItem   OutfitItem @relation(fields: [outfitItemId], references: [id], onDelete: Restrict)
  sku          Sku        @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([outfitSizeId, outfitItemId])
  @@unique([outfitSizeId, displayOrder])
  @@index([skuId])
  @@map("outfit_size_components")
}

model OutfitRevisionMedia {
  outfitRevisionId String         @map("outfit_revision_id") @db.Uuid
  mediaAssetId     String         @map("media_asset_id") @db.Uuid
  displayOrder     Int            @map("display_order")
  featured         Boolean        @default(false)
  outfitRevision   OutfitRevision @relation(fields: [outfitRevisionId], references: [id], onDelete: Restrict)
  mediaAsset       MediaAsset     @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([outfitRevisionId, mediaAssetId])
  @@unique([outfitRevisionId, displayOrder])
  @@index([mediaAssetId])
  @@map("outfit_revision_media")
}

model ColorVariant {
  id                  String            @id @default(uuid()) @db.Uuid
  productId           String            @map("product_id") @db.Uuid
  name                String            @db.VarChar(100)
  normalizedColorCode String            @map("normalized_color_code") @db.VarChar(40)
  displayHex          String?           @map("display_hex") @db.VarChar(7)
  status              PublicationStatus @default(DRAFT)
  displayOrder        Int               @default(0) @map("display_order")
  version             Int               @default(1)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt          DateTime?         @map("archived_at") @db.Timestamptz(6)
  product             Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  mediaAssignments    MediaAssignment[]
  skus                Sku[]
  outfitItems         OutfitItem[]

  @@unique([productId, normalizedColorCode])
  @@index([productId, status, displayOrder])
  @@map("color_variants")
}

model MediaAsset {
  id                     String                    @id @default(uuid()) @db.Uuid
  url                    String                    @db.VarChar(500)
  width                  Int
  height                 Int
  altText                String                    @map("alt_text") @db.VarChar(500)
  colorHex               String?                   @map("color_hex") @db.VarChar(7)
  focalPointX            Float                     @default(0.5) @map("focal_point_x")
  focalPointY            Float                     @default(0.5) @map("focal_point_y")
  format                 MediaFormat
  group                  MediaGroup
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt             DateTime?                 @map("archived_at") @db.Timestamptz(6)
  assignments            MediaAssignment[]
  outfitRevisionMedia    OutfitRevisionMedia[]
