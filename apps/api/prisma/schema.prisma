  fromStatus     OrderFulfillmentStatus? @map("from_status")
  toStatus       OrderFulfillmentStatus? @map("to_status")
  actorId        String                  @map("actor_id") @db.VarChar(120)
  reason         String?                 @db.VarChar(500)
  correlationId  String                  @map("correlation_id") @db.Uuid
  idempotencyKey String                  @unique @map("idempotency_key") @db.VarChar(160)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  order          Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_timeline_events")
}

model ShipmentTrackingRevision {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  carrier        String   @db.VarChar(120)
  trackingNumber String   @map("tracking_number") @db.VarChar(160)
  trackingUrl    String?  @map("tracking_url") @db.VarChar(1000)
  actorId        String   @map("actor_id") @db.VarChar(120)
  reason         String   @db.VarChar(500)
  correlationId  String   @map("correlation_id") @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(160)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("shipment_tracking_revisions")
}

model ReturnRequest {
  id                  String              @id @default(uuid()) @db.Uuid
  orderId             String              @map("order_id") @db.Uuid
  customerId          String              @map("customer_id") @db.Uuid
  status              ReturnRequestStatus @default(SUBMITTED)
  reason              String              @db.VarChar(1000)
  unused              Boolean
  unwashed            Boolean
  tagsAttached        Boolean             @map("tags_attached")
  deliveryConfirmedAt DateTime            @map("delivery_confirmed_at") @db.Timestamptz(6)
  eligibilityDeadline DateTime            @map("eligibility_deadline") @db.Timestamptz(6)
  requestedAt         DateTime            @map("requested_at") @db.Timestamptz(6)
  decisionReason      String?             @map("decision_reason") @db.VarChar(1000)
  decidedAt           DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedBy           String?             @map("decided_by") @db.VarChar(120)
  idempotencyKey      String              @map("idempotency_key") @db.VarChar(120)
  requestHash         String              @map("request_hash") @db.Char(64)
  correlationId       String              @map("correlation_id") @db.Uuid
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items               ReturnItem[]
  refund              Refund?
  movements           InventoryMovement[]

  @@unique([customerId, idempotencyKey])
  @@index([orderId, requestedAt])
  @@index([customerId, requestedAt])
  @@index([status, eligibilityDeadline])
  @@map("return_requests")
}

model ReturnItem {
  id              String        @id @default(uuid()) @db.Uuid
  returnRequestId String        @map("return_request_id") @db.Uuid
  orderItemId     String        @map("order_item_id") @db.Uuid
  quantity        Int
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
}

model Refund {
  id                     String          @id @default(uuid()) @db.Uuid
  orderId                String          @map("order_id") @db.Uuid
  returnRequestId        String?         @unique @map("return_request_id") @db.Uuid
  source                 RefundSource
  amountRial             BigInt          @map("amount_rial")
  currency               String          @default("IRR") @db.Char(3)
  provider               String          @db.VarChar(40)
  providerReference      String?         @map("provider_reference") @db.VarChar(160)
  status                 RefundStatus    @default(PENDING_PROVIDER)
  failureCode            String?         @map("failure_code") @db.VarChar(120)
  requestedAt            DateTime        @map("requested_at") @db.Timestamptz(6)
  confirmedAt            DateTime?       @map("confirmed_at") @db.Timestamptz(6)
  providerIdempotencyKey String          @unique @map("provider_idempotency_key") @db.VarChar(160)
  order                  Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnRequest          ReturnRequest?  @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  attempts               RefundAttempt[]

  @@index([orderId, requestedAt])
  @@index([status, requestedAt])
  @@map("refunds")
}

model RefundAttempt {
  id                String       @id @default(uuid()) @db.Uuid
  refundId          String       @map("refund_id") @db.Uuid
  provider          String       @db.VarChar(40)
  providerReference String?      @map("provider_reference") @db.VarChar(160)
  status            RefundStatus
  failureCode       String?      @map("failure_code") @db.VarChar(120)
  actorId           String       @map("actor_id") @db.VarChar(120)
  reason            String       @db.VarChar(500)
  correlationId     String       @map("correlation_id") @db.Uuid
  idempotencyKey    String       @unique @map("idempotency_key") @db.VarChar(160)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  refund            Refund       @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@index([refundId, createdAt])
  @@map("refund_attempts")
}

model BulkOperation {
  id                  String              @id @default(uuid()) @db.Uuid
  kind                BulkOperationKind
  status              BulkOperationStatus @default(PREVIEWED)
  reason              String              @db.VarChar(500)
  filters             Json
  operation           Json
  actorId             String              @map("actor_id") @db.VarChar(120)
  correlationId       String              @map("correlation_id") @db.Uuid
  version             Int                 @default(1)
  expiresAt           DateTime            @map("expires_at") @db.Timestamptz(6)
  appliedAt           DateTime?           @map("applied_at") @db.Timestamptz(6)
  applyIdempotencyKey String?             @unique @map("apply_idempotency_key") @db.VarChar(120)
  requestHash         String              @map("request_hash") @db.Char(64)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  items               BulkOperationItem[]

  @@index([kind, status, createdAt])
  @@index([expiresAt])
  @@map("bulk_operations")
}

model BulkOperationItem {
  id              String                  @id @default(uuid()) @db.Uuid
  bulkOperationId String                  @map("bulk_operation_id") @db.Uuid
  skuId           String                  @map("sku_id") @db.Uuid
  skuCode         String                  @map("sku_code") @db.VarChar(64)
  beforeValue     BigInt                  @map("before_value")
  proposedValue   BigInt                  @map("proposed_value")
  expectedVersion Int                     @map("expected_version")
  status          BulkOperationItemStatus @default(VALID)
  failureCode     String?                 @map("failure_code") @db.VarChar(120)
  bulkOperation   BulkOperation           @relation(fields: [bulkOperationId], references: [id], onDelete: Restrict)

  @@unique([bulkOperationId, skuId])
  @@index([skuId])
  @@map("bulk_operation_items")
}

model OrderOutfitComponent {
  id                   String    @id @default(uuid()) @db.Uuid
  orderItemId          String    @map("order_item_id") @db.Uuid
  outfitItemIdSnapshot String    @map("outfit_item_id_snapshot") @db.Uuid
  skuIdSnapshot        String    @map("sku_id_snapshot") @db.Uuid
  skuCodeSnapshot      String    @map("sku_code_snapshot") @db.VarChar(64)
  productNameSnapshot  String    @map("product_name_snapshot") @db.VarChar(180)
  colorNameSnapshot    String    @map("color_name_snapshot") @db.VarChar(100)
  sizeLabelSnapshot    String    @map("size_label_snapshot") @db.VarChar(40)
  quantityPerOutfit    Int       @map("quantity_per_outfit")
  totalQuantity        Int       @map("total_quantity")
  displayOrder         Int       @map("display_order")
  orderItem            OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, outfitItemIdSnapshot])
  @@unique([orderItemId, displayOrder])
  @@index([skuIdSnapshot])
  @@map("order_outfit_components")
}

model PaymentReconciliation {
  id                    String                      @id @default(uuid()) @db.Uuid
  checkoutSessionId     String                      @map("checkout_session_id") @db.Uuid
  paymentAttemptId      String                      @map("payment_attempt_id") @db.Uuid
  provider              String                      @db.VarChar(40)
  providerTransactionId String                      @map("provider_transaction_id") @db.VarChar(120)
  verifiedAmountRial    BigInt                      @map("verified_amount_rial")
  currency              String                      @db.Char(3)
  reason                String                      @db.VarChar(120)
  status                PaymentReconciliationStatus @default(OPEN)
  resolutionNote        String?                     @map("resolution_note") @db.VarChar(1000)
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  checkoutSession       CheckoutSession             @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  paymentAttempt        PaymentAttempt              @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@unique([provider, providerTransactionId])
  @@index([status, createdAt])
  @@map("payment_reconciliations")
}

model DatabaseJob {
  id             String            @id @default(uuid()) @db.Uuid
  type           DatabaseJobType
  idempotencyKey String            @unique @map("idempotency_key") @db.VarChar(160)
  payload        Json
  status         DatabaseJobStatus @default(PENDING)
  runAt          DateTime          @map("run_at") @db.Timestamptz(6)
  attemptCount   Int               @default(0) @map("attempt_count")
  maxAttempts    Int               @default(8) @map("max_attempts")
  leaseOwner     String?           @map("lease_owner") @db.VarChar(120)
  leaseExpiresAt DateTime?         @map("lease_expires_at") @db.Timestamptz(6)
  lastErrorCode  String?           @map("last_error_code") @db.VarChar(120)
  lastError      String?           @map("last_error") @db.VarChar(1000)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, runAt])
  @@index([leaseExpiresAt])
  @@map("database_jobs")
}
